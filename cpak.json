{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "PDF Arranger",
  "description": "Merge, split, rotate and rearrange PDF documents.",
  "version": "1.13.0",
  "image": "ghcr.io/containerpak/pdfarranger@sha256:6f1d6346f8886f004568e8adcbbcb1f756faeff3145084b493612a22766c0acb",
  "binaries": [
    "/usr/bin/pdfarranger"
  ],
  "desktop_entries": [
    "/usr/share/applications/com.github.jeromerobert.pdfarranger.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "hostActions": [],
    "filesystem": [
      {
        "path": "xdg-documents",
        "access": "read-write"
      },
      {
        "path": "xdg-download",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": false,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
